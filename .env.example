# ---------------------------------------------------------------------------
# Zugang
# ---------------------------------------------------------------------------
# Gemeinsames Passwort für Robert und Eddie. Mindestens 12 Zeichen,
# zum Beispiel vier zufällige Wörter. Wer es ändert, meldet alle Geräte ab.
APP_PASSWORD=

# Signiert das Login-Cookie. Erzeugen mit: openssl rand -base64 32
# Ein neuer Wert meldet ebenfalls alle Geräte ab.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase (Settings > API Keys). Beides nur serverseitig, niemals NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# GEHEIM. Secret Key (sb_secret_...), umgeht RLS vollständig.
SUPABASE_SECRET_KEY=
